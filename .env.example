# LLM provider: ollama (default), openai, or anthropic
LLM_PROVIDER=ollama

# Ollama settings
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_KEEP_ALIVE=30m

# Conversation history
HISTORY_WINDOW=6

# Optional provider credentials; leave blank when using Ollama
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
